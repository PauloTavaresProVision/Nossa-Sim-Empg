# Copiar para .env e preencher. O ficheiro .env nunca deve ser commitado.
UCALL_APIKEY=colocar_aqui_a_chave_da_ucall

# URL pública do site (sem barra final), usada para construir o link do PDF
# da cotação enviado ao call center no field11. Ex.: https://simulador.dominio.ao
PUBLIC_BASE_URL=https://colocar.o.dominio.aqui

# SMTP para o botão "Quero Contratar" (envio da cotação por email ao
# departamento de protocolos). Pedir as credenciais à NOSSA/bytedigital.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# destino do pedido de contratação (por omissão dep.protocolos@nossaseguros.ao)
EMAIL_PROTOCOLOS=dep.protocolos@nossaseguros.ao